{
  "name": "jbaron/fal_webdav2",
  "description": "TYPO3 FAL storage driver for storing files using Webdav (RFC 4918)",
  "type": "typo3-cms-extension",
  "license": "MIT",
  "keywords": [
    "TYPO3 CMS",
    "FAL",
    "WebDAV"
  ],
  "authors": [
    {
      "name": "Jost Baron",
      "email": "jost.baron@mein-bauernhof.de",
      "role": "Developer"
    }
  ],
  "autoload": {
    "psr-4": {
      "Jbaron\\FalWebdav\\": "Classes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Jbaron\\FalWebdav\\Tests\\": "Tests/"
    }
  },
  "require": {
    "typo3/cms-core": "^10.4 || ^11.5",
    "php": "^7.4 || ^8.0 || ^8.1",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.0",
    "psr/log": "^1.0 || ^2.0 || ^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "guzzlehttp/guzzle": "^7.4",
    "guzzlehttp/psr7": "^2.1"
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "fal_webdav2"
    }
  },
  "config": {
    "allow-plugins": {
      "typo3/cms-composer-installers": true,
      "typo3/class-alias-loader": true
    }
  },
  "scripts": {
    "test": [
      "@test:unit",
      "@test:functional"
    ],
    "test:unit": "phpunit --testsuite Unit",
    "test:functional": "phpunit --testsuite Functional"
  }
}
